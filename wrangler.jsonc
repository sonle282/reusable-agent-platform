{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "reusable-agent-platform",
  "main": "src/worker/index.ts",
  "compatibility_date": "2026-10-10",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": false,
  // Anthropic rejects requests egressing from some edge locations (e.g. HKG).
  // Run fetch handlers near us-east-1 and pin new conversation Durable Objects nearby.
  "placement": {
    "region": "aws:us-east-1"
  },
  "preview_urls": false,
  "routes": [
    { "pattern": "agent.mrspainc.com", "custom_domain": true }
  ],
  "assets": {
    "binding": "ASSETS",
    "directory": "./dist/client",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*", "/health"]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "reusable-agent-platform",
      "migrations_dir": "./migrations"
    }
  ],
  "r2_buckets": [
    {
      "binding": "FILES",
      "bucket_name": "reusable-agent-platform-files"
    }
  ],
  "queues": {
    "producers": [
      {
        "binding": "JOBS",
        "queue": "reusable-agent-platform-jobs"
      }
    ],
    "consumers": [
      {
        "queue": "reusable-agent-platform-jobs",
        "max_batch_size": 5,
        "max_batch_timeout": 5,
        "max_retries": 5,
        "dead_letter_queue": "reusable-agent-platform-dead-letter"
      }
    ]
  },
  "ai": {
    "binding": "AI",
    "remote": true
  },
  "ai_search_namespaces": [
    {
      "binding": "AI_SEARCH",
      "namespace": "default",
      "remote": true
    }
  ],
  "durable_objects": {
    "bindings": [
      {
        "name": "ConversationAgent",
        "class_name": "ConversationAgent"
      }
    ]
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": ["ConversationAgent"]
    }
  ],
  "vars": {
    "APP_ENV": "production",
    "AI_SEARCH_INSTANCE": "agent-platform-knowledge",
    "SESSION_TTL_SECONDS": "43200",
    "CONVERSATION_LOCATION_HINT": "enam"
  },
  "observability": {
    "enabled": true,
    "logs": { "head_sampling_rate": 1 },
    "traces": { "enabled": true, "head_sampling_rate": 0.05 }
  }
}
